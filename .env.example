# ============================================================
# ShelfLife — Supabase Environment Variables (example)
# ============================================================
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# The actual `.env` file is gitignored and should NEVER be
# committed to version control.
# ============================================================

# ------------------------------------------------------------
# Client-side (Vite) variables — exposed to the browser.
# These are SAFE to expose. Use the "anon" / "publishable" key.
# Used by src/integrations/supabase/client.ts via import.meta.env
# ------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# ------------------------------------------------------------
# Server-side (SSR) variables — used by process.env in server
# functions and server routes.
# Used by client.ts, client.server.ts, and auth-middleware.ts.
# ------------------------------------------------------------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# ------------------------------------------------------------
# Service role key — bypasses Row Level Security.
# Keep server-only: never prefix with VITE_, never expose to
# the client. Get it from:
#   Supabase Dashboard → Project Settings → API → service_role
# Used by src/integrations/supabase/client.server.ts
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"
