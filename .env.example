# Copy this file to .env and fill in your own Supabase project's values
# (Supabase dashboard → Project Settings → API).

# Non-VITE_ vars: read server-side only (SSR loaders, server functions)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# VITE_-prefixed vars: bundled into the client — anon/publishable key only,
# never the service role key
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only, optional — needed only if a server function needs to bypass
# RLS (e.g. admin tooling). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
